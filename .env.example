# Nomes dos grupos para monitorar (separados por vírgula)
GROUPS=Nome Grupo 1, Nome Grupo 2

# Diretório onde salvar os arquivos
ARCHIVE_DIR=./archive

# Tempo (ms) para aguardar legenda após mídia sem caption (2 minutos)
BUFFER_TIMEOUT_MS=120000

# Número para receber alertas por DM (opcional - auto-detecta se vazio)
# Formato: 5511999999999 (código do país + DDD + número)
ALERT_NUMBER=

# Alertar quando sobrar menos de X GB no disco
DISK_WARN_GB=5
